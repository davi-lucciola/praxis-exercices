{
  "name": "ebookium",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev\"",
    "dev:web": "bun run --filter frontend dev",
    "build:web": "bun run --filter frontend build",
    "lint:web": "bun run --filter frontend lint",
    "lint:fix:web": "bun run --filter frontend lint:fix",
    "format:web": "bun run --filter frontend format",
    "test:web": "bun run --filter frontend test",
    "test:watch:web": "bun run --filter frontend test:watch",
    "dev:api": "uv run --directory backend task dev",
    "lint:api": "uv run --directory backend task lint",
    "format:api": "uv run --directory backend task format",
    "test:api": "uv run --directory backend task test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
